  "8d77787d-29d9-405f-a8a7-5d42bd854c11": {
    "behavior": {
      "keywords": ["tactical"],
      "onPlay": {
        "costs": [
          {
            "type": "discard",
            "id": "toss",
            "player": "controller",
            "selector": {
              "zone": "hand",
              "conditions": [
                {
                  "type": "cardTradeIs",
                  "target": { "type": "selected", "id": "__candidate" },
                  "trade": "rogue"
                },
                {
                  "type": "not",
                  "condition": {
                    "type": "cardTypeIs",
                    "target": { "type": "selected", "id": "__candidate" },
                    "cardType": "resource"
                  }
                }
              ]
            },
            "count": 1
          }
        ]
      },
      "abilities": [
        {
          "id": "cicibeo-seize",
          "type": "triggered",
          "event": "cardEnteredPlay",
          "condition": {
            "type": "and",
            "conditions": [
              { "type": "not", "condition": { "type": "sourceIsEventCard" } },
              { "type": "cardSubtypeIs", "target": "eventCard", "subtype": "cicibeo" },
              { "type": "eventCardControlledBy", "player": "controller" },
              {
                "type": "numberCompare",
                "left": { "type": "resourceIcons", "player": "controller", "icon": "deception" },
                "operator": ">=",
                "right": 6
              }
            ]
          },
          "effects": [
            {
              "type": "chooserSelectsTarget",
              "chooser": "controller",
              "declaration": {
                "id": "grab",
                "selector": { "zone": "play", "type": "character" },
                "count": 1,
                "optional": true
              },
              "effects": [
                {
                  "type": "if",
                  "condition": { "type": "targetExists", "target": { "type": "selected", "id": "grab" } },
                  "effects": [
                    {
                      "type": "takeControl",
                      "target": { "type": "selected", "id": "grab" },
                      "controller": "controller"
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    "cardPatch": { "unique": "cicibeo" },
    "notes": "Character with TACTICAL, so EXTRA COST discard lives in behavior.onPlay.costs (the documented home for a non-tactic permanent's EXTRA COST). 'if it was deployed from your hand' cannot be expressed (cardEnteredPlay does not carry the source zone) -- dropped, and approximated with eventCardControlledBy controller. [D][D][D][D][D][D] icon paragraph modeled as a resourceIcons(deception) >= 6 condition on the triggered ability. 'cicibeo' subtype is present on the card's printed subtype list. Renderer note: getPlayTargetDeclarations does not surface a discard-cost id, so the play flow must pass selected.toss (same as existing activated-ability discard costs like Fired Hand)."
  },

