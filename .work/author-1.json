  "6a477977-867b-4cdc-acc0-1d3f00923031": {
    "behavior": {
      "keywords": ["tactical"],
      "onPlay": {
        "condition": { "type": "not", "condition": { "type": "battleActive" } }
      },
      "abilities": [
        {
          "id": "drill-instructor-etb",
          "type": "triggered",
          "event": "cardEnteredPlay",
          "condition": { "type": "sourceIsEventCard" },
          "targets": [
            {
              "id": "pick",
              "selector": {
                "zone": "play",
                "type": "character",
                "conditions": [
                  {
                    "type": "not",
                    "condition": {
                      "type": "cardNameEquals",
                      "target": { "type": "selected", "id": "__candidate" },
                      "other": "source"
                    }
                  }
                ]
              },
              "count": 1
            }
          ],
          "effects": [
            {
              "type": "rememberTarget",
              "key": "buffee",
              "target": { "type": "selected", "id": "pick" }
            },
            {
              "type": "scheduleEffect",
              "when": "startOfNextTurn",
              "condition": { "type": "linkedCardInPlay", "key": "buffee" },
              "effects": [
                {
                  "type": "createModifier",
                  "target": { "type": "remembered", "key": "buffee" },
                  "stat": "strength",
                  "operation": "add",
                  "value": 3,
                  "duration": { "type": "untilEndOfTurn" }
                }
              ]
            }
          ]
        }
      ]
    },
    "notes": "'Deploy this only not during a battle' -> onPlay.condition not battleActive. 'the next turn' is modeled as scheduleEffect startOfNextTurn, which fires at the start of the SOURCE controller's next turn, not the immediately-following (opponent's) turn -- a schedule-any-next-turn primitive would be needed for exact parity. 'pick another character' uses not(cardNameEquals __candidate source), which also excludes other copies sharing this card's name."
  },

