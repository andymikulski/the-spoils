  "7e485e5b-2d3a-4013-98d9-f7c9e47ccb57": {
    "behavior": {
      "onPlay": {
        "targets": [
          {
            "id": "p",
            "selector": {
              "zone": "play",
              "conditions": [
                {
                  "type": "or",
                  "conditions": [
                    {
                      "type": "cardTypeIs",
                      "target": { "type": "selected", "id": "__candidate" },
                      "cardType": "character"
                    },
                    {
                      "type": "cardTypeIs",
                      "target": { "type": "selected", "id": "__candidate" },
                      "cardType": "location"
                    }
                  ]
                },
                {
                  "type": "numberCompare",
                  "left": { "type": "resourceIcons", "player": "controller", "icon": "obsession" },
                  "operator": ">=",
                  "right": 3
                }
              ]
            },
            "count": 1,
            "optional": true
          }
        ],
        "effects": [
          {
            "type": "if",
            "condition": {
              "type": "and",
              "conditions": [
                { "type": "targetExists", "target": { "type": "selected", "id": "p" } },
                {
                  "type": "or",
                  "conditions": [
                    {
                      "type": "and",
                      "conditions": [
                        {
                          "type": "cardTypeIs",
                          "target": { "type": "selected", "id": "p" },
                          "cardType": "character"
                        },
                        {
                          "type": "statCompare",
                          "target": { "type": "selected", "id": "p" },
                          "stat": "strength",
                          "operator": "<=",
                          "value": 3
                        }
                      ]
                    },
                    {
                      "type": "and",
                      "conditions": [
                        {
                          "type": "cardTypeIs",
                          "target": { "type": "selected", "id": "p" },
                          "cardType": "location"
                        },
                        {
                          "type": "statCompare",
                          "target": { "type": "selected", "id": "p" },
                          "stat": "structure",
                          "operator": "<=",
                          "value": 3
                        }
                      ]
                    }
                  ]
                }
              ]
            },
            "effects": [
              { "type": "moveCard", "target": { "type": "selected", "id": "p" }, "to": "hand" }
            ]
          }
        ]
      }
    },
    "notes": "The [O][O][O] gate is folded into the target selector as a global numberCompare, so no candidate is legal unless you control 3+ obsession icons. The strength/structure check is split per type (and(character, strength<=3) OR and(location, structure<=3)) rather than the slice's loose 'strength<=3 OR structure<=3', because a character reads structure 0 (and a location reads strength 0), which would make the loose form always true."
  },

