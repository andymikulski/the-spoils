  "25d8789e-b481-4c1d-aae5-8c3cb2d22786": {
    "behavior": {
      "abilities": [
        {
          "id": "confrontational-conflagration-play",
          "type": "activated",
          "condition": {
            "type": "and",
            "conditions": [
              { "type": "isActivePlayer", "player": "controller" },
              { "type": "not", "condition": { "type": "battleActive" } }
            ]
          },
          "targets": [
            { "id": "mine", "selector": { "controller": "self", "zone": "play", "type": "character" }, "count": 1 },
            { "id": "theirs", "selector": { "controller": "opponent", "zone": "play", "type": "character" }, "count": 1 },
            { "id": "loc", "selector": { "zone": "play", "type": "location" }, "count": 1, "optional": true }
          ],
          "effects": [
            {
              "type": "bind",
              "id": "x",
              "value": {
                "type": "conditional",
                "if": { "type": "cardSubtypeIs", "target": { "type": "selected", "id": "mine" }, "subtype": "dragon" },
                "then": { "type": "multiply", "values": [ 2, { "type": "stat", "target": { "type": "selected", "id": "mine" }, "stat": "strength" } ] },
                "else": { "type": "stat", "target": { "type": "selected", "id": "mine" }, "stat": "strength" }
              }
            },
            { "type": "dealDamage", "target": { "type": "selected", "id": "mine" }, "amount": { "type": "variable", "id": "x" } },
            { "type": "dealDamage", "target": { "type": "selected", "id": "theirs" }, "amount": { "type": "variable", "id": "x" } },
            {
              "type": "if",
              "condition": { "type": "targetExists", "target": { "type": "selected", "id": "loc" } },
              "effects": [
                { "type": "dealDamage", "target": { "type": "selected", "id": "loc" }, "amount": { "type": "variable", "id": "x" } }
              ]
            }
          ]
        }
      ]
    },
    "cardPatch": { "flipUp": { "cost": 1, "threshold": "rrr" } },
    "notes": "Deviation from the slice shape: the printed text says 'Inflict X damage to EACH picked card', so damage is dealt to all three picks (mine, theirs, and the location if chosen), not just theirs + loc. X = 2*strength of your picked character if it is a 'dragon' (printed subtype), else its strength. Timing gate on the tactic's first activated ability: your turn, not during a battle."
  },

  "fd6b9183-805b-44d0-a3c0-dbb0758bd4b8": {
    "behavior": {
      "abilities": [
        {
          "id": "contractual-execution-play",
          "type": "activated",
          "targets": [
            { "id": "ch", "selector": { "zone": "play", "type": "character" }, "count": 1 }
          ],
          "effects": [
            {
              "type": "if",
              "condition": {
                "type": "numberCompare",
                "left": {
                  "type": "count",
                  "selector": {
                    "controller": "self",
                    "zone": "play",
                    "type": "character",
                    "conditions": [
                      { "type": "targetInSelection", "target": { "type": "selected", "id": "__candidate" }, "selection": "ch" }
                    ]
                  }
                },
                "operator": ">=",
                "right": 1
              },
              "effects": [
                {
                  "type": "chooserSelectsTarget",
                  "chooser": "controller",
                  "declaration": {
                    "id": "resSelf",
                    "selector": { "controller": "self", "zone": "play", "type": "resource" },
                    "count": 1
                  },
                  "effects": [
                    { "type": "moveCard", "target": { "type": "selected", "id": "resSelf" }, "to": "hand" }
                  ]
                }
              ]
            },
            {
              "type": "if",
              "condition": {
                "type": "numberCompare",
                "left": {
                  "type": "count",
                  "selector": {
                    "controller": "opponent",
                    "zone": "play",
                    "type": "character",
                    "conditions": [
                      { "type": "targetInSelection", "target": { "type": "selected", "id": "__candidate" }, "selection": "ch" }
                    ]
                  }
                },
                "operator": ">=",
                "right": 1
              },
              "effects": [
                {
                  "type": "chooserSelectsTarget",
                  "chooser": "opponent",
                  "declaration": {
                    "id": "resOpp",
                    "selector": { "controller": "opponent", "zone": "play", "type": "resource" },
                    "count": 1
                  },
                  "effects": [
                    { "type": "moveCard", "target": { "type": "selected", "id": "resOpp" }, "to": "hand" }
                  ]
                }
              ]
            },
            { "type": "flipFaceDown", "target": { "type": "selected", "id": "ch" } }
          ]
        }
      ]
    },
    "notes": "'That character's controller picks a resource they control' — CardSelector cannot be scoped by a controllerOf(target) PlayerRef, so instead of the classification's controllerOf approach this branches on whether the picked character is self- or opponent-controlled (count + targetInSelection) and runs the matching chooser/selector pair. Then the character is flipped face-down under its owner's control (wipes damage/counters/attachments per RULES.md §2)."
  },

