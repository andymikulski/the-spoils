{
  // Compiles types-test/consumer.ts the way a strict downstream TypeScript
  // project would: importing the package by name (resolved through the
  // `exports` map onto build/), no DOM or Node types, skipLibCheck off.
  // Run after `npm run build`.
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2022",
    "lib": ["es2022"],
    "types": [],
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": false,
    "noEmit": true
  },
  "files": ["consumer.ts"]
}
