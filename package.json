{
  "name": "the-spoils",
  "version": "1.1.0",
  "description": "Data-driven, UI-free rules engine and card database for The Spoils CCG",
  "license": "MIT",
  "author": "Andy Mikulski",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andymikulski/the-spoils.git"
  },
  "homepage": "https://github.com/andymikulski/the-spoils#readme",
  "bugs": {
    "url": "https://github.com/andymikulski/the-spoils/issues"
  },
  "keywords": [
    "the-spoils",
    "ccg",
    "tcg",
    "card-game",
    "rules-engine",
    "game-engine",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./build/src/engine.js",
  "types": "./build/src/engine.d.ts",
  "typesVersions": {
    "*": {
      "data": [
        "./build/src/data.d.ts"
      ],
      "sets": [
        "./build/src/sets.d.ts"
      ],
      "sets/*": [
        "./build/src/data/sets/*.d.ts"
      ],
      "assets": [
        "./build/src/assets.d.ts"
      ],
      "card-text": [
        "./build/src/cardText.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./build/src/engine.d.ts",
      "default": "./build/src/engine.js"
    },
    "./data": {
      "types": "./build/src/data.d.ts",
      "default": "./build/src/data.js"
    },
    "./sets": {
      "types": "./build/src/sets.d.ts",
      "default": "./build/src/sets.js"
    },
    "./sets/*": {
      "types": "./build/src/data/sets/*.d.ts",
      "default": "./build/src/data/sets/*.js"
    },
    "./assets": {
      "types": "./build/src/assets.d.ts",
      "default": "./build/src/assets.js"
    },
    "./card-text": {
      "types": "./build/src/cardText.d.ts",
      "default": "./build/src/cardText.js"
    },
    "./images/*": "./data/assets/*",
    "./package.json": "./package.json"
  },
  "files": [
    "build/src",
    "data/sets.json",
    "data/cards",
    "data/assets",
    "LEGAL.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('build',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "node scripts/run-tests.cjs",
    "test:seats": "node scripts/seat-tests.cjs",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "sync-cards": "node scripts/sync-cards.cjs",
    "card-markup": "node --import tsx scripts/card-markup/cli.ts",
    "card-tests": "node --import tsx scripts/card-tests/cli.ts",
    "rule-tests": "node --import tsx scripts/rule-tests/cli.ts",
    "record-replays": "node --import tsx scripts/record-replays.ts",
    "typecheck:consumer": "tsc -p types-test/tsconfig.json && tsc -p types-test/tsconfig.bundler.json"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "prettier": "^3.9.6",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
